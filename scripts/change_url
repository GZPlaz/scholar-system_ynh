#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progress "Stopping $app's systemd service..."

ynh_systemctl --service="$app" --action="stop" --log_path="/var/log/$app/$app.log"

#=================================================
# MODIFY URL IN NGINX CONF
#=================================================
ynh_script_progress "Updating NGINX web server configuration..."

ynh_config_change_url_nginx

#=================================================
# UPDATE THE APP CONFIGURATION (sub-path and SSO URL)
#=================================================
ynh_script_progress "Updating $app's configuration..."

domain="$new_domain"
path="$new_path"
ynh_config_add --template="scholar.env" --destination="$install_dir/scholar.env"
_scholar_set_permissions

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progress "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --log_path="/var/log/$app/$app.log" --wait_until="Booting worker"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progress "Change of URL completed for $app"
