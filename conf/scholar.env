# Scholar System configuration — generated by the YunoHost package.
# Manual edits are detected and backed up on upgrade; prefer the in-app settings page.
SCHOLAR_INSTANCE=__APP__
SCHOLAR_SECRET_KEY=__SECRET_KEY__
SCHOLAR_DATABASE_URL=postgresql+psycopg2://__DB_USER__:__DB_PWD__@127.0.0.1:5432/__DB_NAME__
SCHOLAR_PATH=__PATH__
SCHOLAR_SECURE_COOKIES=true
SCHOLAR_TRUST_PROXY=true

# YunoHost accounts: password sign-in against the local LDAP directory
SCHOLAR_LDAP_ENABLED=true
SCHOLAR_LDAP_URI=ldap://127.0.0.1:389
SCHOLAR_LDAP_USER_BASE=ou=users,dc=yunohost,dc=org

# YunoHost single sign-on (SSOwat) — identity headers are set by nginx, see nginx.conf
SCHOLAR_SSO_ENABLED=true
SCHOLAR_SSO_LOGIN_URL=https://__DOMAIN__/yunohost/sso/

SCHOLAR_ADMIN=__ADMIN__
SCHOLAR_TIMEZONE=__TIMEZONE__
